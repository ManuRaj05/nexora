# Copy to .env and replace every placeholder before starting Compose.
# Use URL-safe alphanumeric secrets so DATABASE_URL values need no URL encoding.
POSTGRES_USER=nexora_app
POSTGRES_PASSWORD=REPLACE_WITH_URL_SAFE_RANDOM_PASSWORD
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
ORDER_SERVICE_TOKEN=REPLACE_WITH_A_DIFFERENT_RANDOM_TOKEN

# Optional host ports for the browser UI and direct Gateway debugging.
FRONTEND_PORT=5173
GATEWAY_PORT=8081
